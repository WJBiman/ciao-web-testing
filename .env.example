# =============================================================================
# CIAO (Pvt) Ltd — Centralized Web-Based Bus Reservation & Logistics Platform
# Example Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env or configure your system environment variables.
# NEVER commit real production credentials or private keys to version control.

# Database Configuration (MySQL / MariaDB)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ciao_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# JWT & Security Configuration (Must be at least 32 bytes for HMAC-SHA256)
CIAO_JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_placeholder
CIAO_COOKIE_SECURE=false

# Application Server Port
PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080
